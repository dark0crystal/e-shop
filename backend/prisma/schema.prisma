generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  phone        String?
  isAdmin      Boolean   @default(false) @map("is_admin")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  wishlists    Wishlist[]
  cartItems    CartItem[]
  orders       Order[]
  userPaymentMethod     UserPaymentMethod[]
  reviews      ProductReview[]
  shoppingCart ShoppingCart[]
  userAddress   UserAddress[]
}

model Category {
  id                String     @id @default(uuid())
  name              String     @unique
  description       String?
  parentCategoryId  String?    @map("parent_category_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  slug              String     @unique
  parentCategory    Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories     Category[] @relation("CategoryHierarchy")
  products          Product[]
  variation         Variation[]
  promotionCategory   PromotionCategory[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String
  // price          Decimal         @db.Decimal(10, 2)
  // stockQuantity  Int             @map("stock_quantity")
  brand          String
  // sku            String          @unique
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  categoryId     String
  coverImage     String
  // images         ProductImage[]
  wishlists      Wishlist[]
  productItem    ProductItem[]
  // cartItems      CartItem[]
  orderItems     OrderItem[]
  
}

 model ProductItem{
     id                String     @id @default(uuid())
     price          Decimal         @db.Decimal(10, 2)
     stockQuantity  Int             @map("stock_quantity")
     sku            String          @unique
     productId      String
     product        Product @relation(fields: [productId],references: [id])
     images         ProductImage[]   
     productConfig  ProductConfig[]
     cartItem       CartItem[]
 }

model ProductImage {
  id         String   @id @default(uuid())
  product    ProductItem  @relation(fields: [productId], references: [id])
  productId  String
  imageUrl   String   @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at")
}

model ProductConfig{
  id         String   @id @default(uuid())
  productItemId String
  variationOptionId String
  variationOption VariationOption @relation(fields: [variationOptionId], references: [id])
  productItem     ProductItem @relation(fields: [productItemId], references: [id])
  
}

model Variation{
  id         String   @id @default(uuid())
  categoryId String 
  name String 
  slug              String     @unique
  category    Category @relation(fields: [categoryId],references: [id])
  variationOption            VariationOption[]
  // productConfig              ProductConfig[]
  
}

model VariationOption{
    id         String   @id @default(uuid())
    value     String
    variationId String
    variation   Variation @relation(fields: [variationId], references: [id])
    productConfig    ProductConfig[]
}


model Wishlist {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  createdAt  DateTime @default(now()) @map("created_at")
}

model CartItem {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  productItem    ProductItem  @relation(fields: [productItemId], references: [id])
  productItemId  String
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
}

model ShoppingCart{
   id         String   @id @default(uuid())
   userId     String
   user      User @relation(fields: [userId], references: [id])

}

model Order {
  id             String        @id @default(uuid())
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  totalPrice     Decimal       @db.Decimal(10, 2) @map("total_price")
  status         String
  // paymentStatus  String        @map("payment_status")
  userPaymentMethodId  String  
  userPaymentMethod  UserPaymentMethod @relation(fields: [userPaymentMethodId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  items          OrderItem[]
  shippingMethodId String
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  orderStatusId String
  orderStatus OrderStatus @relation(fields: [orderStatusId], references: [id])
  // shipping       OrderShipping[]
}

model Address {
  id           String   @id @default(uuid())
  unitNumber   String?  
  streetNumber String?  
  addressLine  String?  
  city         String
  region       String
  countryId    String
  country      Country  @relation(fields: [countryId], references: [id])
  userAddress   UserAddress[]
}


model Country{
  id             String        @id @default(uuid())
  countryName String
  address Address[]
}

model UserAddress{
    id             String        @id @default(uuid())
    userId String 
    addressId  String
    user User @relation(fields: [userId], references: [id])
    address Address @relation(fields: [addressId], references: [id])
}

model ShippingAddr{
      id             String        @id @default(uuid())
      orderId  String

}

model OrderItem {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
}

