model ShippingMethod{
  id             String   @id @default(uuid())
  name String
  price String
  order Order[]
}

model OrderStatus{
    id             String   @id @default(uuid())
    status  String
    order Order[]
}

model OrderLine{
    id             String   @id @default(uuid())
    productItemId   String
    orderId   String
    qty    Int
    price     Decimal  @db.Decimal(10, 2)
    reviews        ProductReview[]

}

model ProductReview {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  orderLine  OrderLine  @relation(fields: [orderLineId], references: [id])
  orderLineId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
}

model PromotionCategory{
    id         String   @id @default(uuid())
    categoryId    String
    promotionId String
    category  Category @relation(fields: [promotionId] ,references: [id])
    promotion Promotion @relation(fields: [categoryId], references: [id])

}

model Promotion {
  id           String   @id @default(uuid())
  name         String
  description  String
  discountRate Float     
  startDate    DateTime  
  endDate      DateTime  
  promotionCategory PromotionCategory[]
}

model ShippingProvider {
  id           String            @id @default(uuid())
  name         String
  deliveryTime String           @map("delivery_time")
  cost         Decimal          @db.Decimal(10, 2)
  createdAt    DateTime         @default(now()) @map("created_at")

  // orders       OrderShipping[]
}

model UserPaymentMethod{
  id           String            @id @default(uuid())
  userId  String
  user User @relation(fields: [userId], references: [id])
  paymentTypeId    String
  paymentType    PaymentType @relation(fields: [paymentTypeId], references: [id])
  provider    String
  accountNumber     Int
  expiryDate   DateTime
  isDefault    Boolean   @default(true)
  order Order[]
}


model PaymentType{
  id           String            @id @default(uuid())
  value String
  userPaymentMethod UserPaymentMethod[]
    
}

